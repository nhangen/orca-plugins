{
  "manifestVersion": 2,
  "id": "git-issues",
  "name": "Git Issues, PRs & Branches",
  "version": "0.1.4",
  "description": "Show GitHub issues, pull requests, and git branches for the currently loaded repository in Orca's sidebar.",
  "license": "MIT",
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "Git Issues, PRs & Branches for Orca"
  },
  "screenshots": [
    {
      "path": "assets/screenshot.png",
      "alt": "Git Issues, PRs and Branches sidebar panel in Orca",
      "caption": "Track issues, pull requests, and branches directly in Orca sidebar",
      "theme": "dark"
    }
  ],
  "repository": "https://github.com/nhangen/orca-plugins",
  "homepage": "https://github.com/nhangen/orca-plugins",
  "author": {
    "name": "Nathan Hangen",
    "url": "https://github.com/nhangen"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "git-issues",
        "title": "Git Issues, PRs & Branches",
        "icon": "branch",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
